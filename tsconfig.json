{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "skipLibCheck": true
  },
  "include": ["src", "tests", "server", "functions", "worker-configuration.d.ts", "vite.config.ts", "playwright.config.ts"]
}
